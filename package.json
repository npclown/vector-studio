{
  "name": "vector-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent vector editor SDK and directly owned graphics engine.",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "benchmark:p0": "node tooling/pending-command.mjs benchmark:p0 P0.5",
    "benchmark:p0:p0-3": "pnpm build && playwright test --config playwright.p0-3-benchmark.config.ts",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run check:boundaries",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:gpu": "node tooling/pending-command.mjs test:gpu P0.4",
    "test:unit": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@vector-studio/contracts": "workspace:*",
    "@vector-studio/renderer-core": "workspace:*",
    "@vector-studio/renderer-webgpu": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
