{
  "name": "vector-studio",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-independent vector editor SDK and directly owned graphics engine.",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "24.15.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "benchmark:p0": "node tooling/run-p0-benchmark.mjs",
    "benchmark:p1": "node tooling/run-p1-benchmark.mjs",
    "benchmark:p2": "node tooling/run-p2-benchmark.mjs",
    "benchmark:p3-b0": "node tooling/run-p3-b0-benchmark.mjs",
    "benchmark:p3-b0-wasm": "node tooling/run-p3-b0-wasm-benchmark.mjs",
    "benchmark:p3-b0-spike": "node tooling/run-p3-b0-spike-benchmark.mjs",
    "benchmark:p3-fill-ladder": "node tooling/run-p3-fill-ladder-benchmark.mjs",
    "benchmark:p3-al-ob5": "node tooling/run-p3-al-ob5-benchmark.mjs",
    "benchmark:p0:p0-3": "pnpm build && playwright test --config playwright.p0-3-benchmark.config.ts",
    "build": "pnpm --recursive --if-present run build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run check:boundaries",
    "check:boundaries": "node tooling/check-boundaries.mjs",
    "coverage:p3-o01": "node tooling/run-p3-coverage-metrics.mjs",
    "coverage:p3-o02": "node tooling/run-p3-o02-metrics.mjs",
    "report:p3-t03": "vitest run --config vitest.p3-t03.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:gpu": "playwright test --config playwright.gpu.config.ts",
    "test:gpu:viz-v4": "playwright test --config playwright.gpu.config.ts tests/gpu/viz-v4-a08-corpus.spec.ts",
    "test:gpu:p3-projection": "playwright test --config playwright.p3-native-projection.config.ts",
    "test:gpu:p3-coverage": "playwright test --config playwright.p3-coverage.config.ts",
    "test:gpu:p3-o02": "playwright test --config playwright.p3-o02.config.ts",
    "test:geometry": "node tooling/test-geometry.mjs",
    "test:geometry:browser": "node tooling/test-geometry-browser.mjs",
    "test:e3-a04": "vitest run --config vitest.e3-a04.config.ts",
    "e3-a04:freeze": "node tooling/run-e3-a04-freeze.mjs",
    "e3-a04:run": "node tooling/run-e3-a04.mjs",
    "viz-v4:expected": "node tooling/run-viz-v4-expected.mjs",
    "p3-exit:sweep": "node tooling/run-p3-exit-sweep.mjs",
    "e14:fill-diag": "node tooling/run-e14-fill-diag.mjs",
    "test:p2-identity": "node tooling/compare-p2-wasm.mjs",
    "test:p3-fill-identity": "node tooling/compare-p3-fill-identity.mjs",
    "compare:p3-b0-records": "node tooling/compare-p3-b0-records.mjs",
    "test:unit": "vitest run",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@vector-studio/contracts": "workspace:*",
    "@vector-studio/renderer-core": "workspace:*",
    "@vector-studio/renderer-webgpu": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
