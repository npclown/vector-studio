    "tooling/**/*.d.mts",
    "vitest*.config.ts"
  ],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/editor-core" },
    { "path": "./packages/geometry-reference" },
    { "path": "./packages/geometry-wasm" },
    { "path": "./packages/model" },
    { "path": "./packages/persistence-idb" },
    { "path": "./packages/react" },
    { "path": "./packages/renderer-core" },
    { "path": "./packages/renderer-webgpu" },
