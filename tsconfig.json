{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "apps/next-host/app/m6a-*/route.ts",
    "apps/next-host/app/m6b-*/route.ts",
    "apps/next-host/src/m4-appearance.ts",
    "apps/next-host/src/m5-persistence.ts",
    "apps/next-host/src/m6a-text-host.ts",
    "apps/next-host/src/m6b-text-edit.ts",
    "playwright*.config.ts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "tooling/**/*.d.mts",
    "vitest*.config.ts"
  ],
  "references": [
    { "path": "./packages/contracts" },
    { "path": "./packages/editor-core" },
    { "path": "./packages/geometry-reference" },
    { "path": "./packages/geometry-wasm" },
    { "path": "./packages/model" },
    { "path": "./packages/persistence-idb" },
    { "path": "./packages/react" },
    { "path": "./packages/renderer-core" },
    { "path": "./packages/renderer-webgpu" },
    { "path": "./packages/text-dom" },
    { "path": "./apps/playground" }
  ]
}
