    "apps/next-host/app/m6c-*/route.ts",
    "apps/next-host/src/m2-geometry.ts",
    "apps/next-host/src/m3-path-overlay.ts",
    "apps/next-host/src/m5-persistence.ts",
    "apps/next-host/src/m6a-text-host.ts",
    "apps/next-host/src/m6b-text-edit.ts",
    "apps/next-host/src/m6c-text-probe.ts",
    "apps/next-host/src/m6c-text-reference.ts",
    "apps/next-host/src/m8-layout.tsx",
    "apps/next-host/src/m8-star-panel.tsx",
    "apps/next-host/src/v25-artboards.tsx",
    "apps/next-host/src/v25-studio.tsx",
    "apps/next-host/src/v25-text-box.ts",
    "apps/next-host/src/v25-text-colour-default.ts",
