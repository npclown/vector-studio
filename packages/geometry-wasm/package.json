{
  "name": "@vector-studio/geometry-wasm",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "The Vector Studio geometry kernel (WASM) and its fill and stroke mesh adapters.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/npclown/vector-studio.git",
    "directory": "packages/geometry-wasm"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel-url.d.ts",
      "import": "./dist/kernel-url.js"
    },
    "./kernel.wasm": "./dist/kernel.wasm"
  },
  "files": [
    "dist",
    "src",
    "!dist/*.tsbuildinfo"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
    "@vector-studio/contracts": "workspace:*"
  },
  "scripts": {
    "build": "tsc --build",
    "build:kernel": "node ../../tooling/build-geometry-kernel.mjs",
    "prepack": "tsc --build && node ../../tooling/build-geometry-kernel.mjs"
  }
}
